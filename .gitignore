# Real-world email corpora used for eval/calibration must never be committed:
# they contain real third-party addresses and sometimes malware samples.
eval/data/phishing/*
eval/data/legit/*
!eval/data/phishing/.gitkeep
!eval/data/legit/.gitkeep
