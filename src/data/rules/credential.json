{
  "version": "1.0.0",
  "rules": [
    {
      "id": "CRED-PASSWORD",
      "category": "credential",
      "weight": 25,
      "title": "Request to provide a password or credentials",
      "why": "No reputable organisation asks for your password by email. This is the single strongest indicator of a credential-phishing attempt.",
      "advice": "Never send your password. If you already replied, change that password immediately from the official site and enable multi-factor authentication.",
      "mitre": ["T1598"],
      "confidence": "high",
      "patterns": [
        { "type": "anyOf", "values": ["enter your password", "re-enter your password", "confirm your password", "verify your password", "update your password", "reset your password", "supply your password", "provide your password", "send your password", "share your password", "reply with your password", "type your password", "input your password", "your current password", "your existing password"] },
        { "type": "anyOf", "values": ["provide your credentials", "enter your credentials", "confirm your credentials", "verify your credentials", "login credentials", "your login details", "your account credentials", "send us your credentials", "share your credentials"] },
        { "type": "anyOf", "values": ["sign in to continue", "sign in below", "log in to verify", "login to verify", "log in to restore", "login to restore", "log in to unlock", "sign in to unlock", "log in to avoid", "sign in to avoid"] },
        { "type": "anyOf", "values": ["fill in your password", "enter password below", "username and password", "user id and password", "userid and password", "password field", "submit your password", "enter your login"] },
        { "type": "proximity", "a": ["password", "credentials", "login", "sign in", "log in", "user id", "userid"], "b": ["enter", "provide", "confirm", "verify", "update", "reply", "send", "share", "submit", "type", "input", "re-enter", "reset"], "distance": 5 }
      ],
      "negations": ["never ask", "never ask you", "will not ask", "won't ask", "do not ask", "don't ask", "we never", "no one will ask", "never share your password", "do not share your password", "never disclose your password", "do not disclose your password", "we will never request"],
      "examples": ["Please confirm your password to keep your account active.", "Reply with your password to verify."],
      "falsePositives": ["Security-awareness notices saying 'we will never ask for your password' - handled by the negation list."]
    },
    {
      "id": "CRED-MFA-CODE",
      "category": "credential",
      "weight": 25,
      "title": "Request for an OTP, MFA or verification code",
      "why": "One-time codes are the last line of defence. An attacker who already has your password asks you to read out the code so they can defeat multi-factor authentication.",
      "advice": "Never share an OTP. No legitimate support person needs your one-time code, ever.",
      "mitre": ["T1111", "T1598"],
      "confidence": "high",
      "patterns": [
        { "type": "anyOf", "values": ["send us the code", "send me the code", "share the code", "share your code", "forward the code", "forward your code", "provide the code", "provide your code", "give me the code", "give us the code", "reply with the code", "enter the code", "read out the code"] },
        { "type": "anyOf", "values": ["one-time password", "one time password", "one-time code", "otp", "verification code", "security code", "authentication code", "auth code", "6-digit code", "six digit code", "8-digit code", "two-factor code", "2fa code", "mfa code"] },
        { "type": "anyOf", "values": ["we sent you a code", "code we sent", "code has been sent", "code will be sent", "enter the otp", "share the otp", "provide the otp", "otp received", "confirm the otp", "verify the otp"] },
        { "type": "anyOf", "values": ["authenticator code", "authenticator app code", "approve the login", "approve the request", "approve the sign-in", "tap approve", "accept the push notification", "confirm the login request"] },
        { "type": "proximity", "a": ["otp", "code", "one-time", "verification", "mfa", "2fa", "authenticator"], "b": ["send", "share", "forward", "provide", "give", "reply", "tell", "read", "confirm", "enter"], "distance": 5 }
      ],
      "negations": ["never share", "never send", "do not share", "don't share", "will not ask", "never ask", "no one will ask", "do not send", "never reveal"],
      "examples": ["For security, please share the 6-digit code we just sent to your phone."],
      "falsePositives": ["Genuine sign-in mails state a code for you to type into the real app; wording 'share/reply/forward the code' is the tell."]
    },
    {
      "id": "CRED-SENSITIVE-DATA",
      "category": "credential",
      "weight": 25,
      "title": "Request for highly sensitive personal or financial data",
      "why": "Card numbers, CVV/PIN, recovery phrases and government identifiers are exactly the data attackers monetise or use to take over accounts.",
      "advice": "Do not send these by email. If you already did, contact your bank/provider immediately using a number from your card or official app.",
      "mitre": ["T1598"],
      "confidence": "high",
      "patterns": [
        { "type": "anyOf", "values": ["card number", "credit card number", "debit card number", "cvv", "cvc", "card verification", "full card details", "card details", "16-digit", "card expiry", "expiry date of your card"] },
        { "type": "anyOf", "values": ["your pin", "enter your pin", "atmpin", "atm pin", "upi pin", "mpin", "net banking pin", "card pin", "share your pin"] },
        { "type": "anyOf", "values": ["seed phrase", "recovery phrase", "secret phrase", "mnemonic", "private key", "wallet phrase", "12-word phrase", "24-word phrase", "recovery seed"] },
        { "type": "anyOf", "values": ["aadhaar number", "aadhar number", "pan number", "pan card number", "your pan", "your aadhaar", "social security number", "ssn", "national id", "voter id", "passport number", "date of birth and mother's maiden name"] },
        { "type": "anyOf", "values": ["net banking login", "internet banking credentials", "netbanking id", "netbanking password", "banking password", "upi id and pin", "account number and ifsc", "ifsc code and account number"] }
      ],
      "negations": ["never share", "never provide", "do not share", "we never ask", "will never ask"],
      "examples": ["To complete the KYC, share your Aadhaar number and net banking password."],
      "falsePositives": ["Invoices may list a company's own bank details (legitimate); this rule keys on requests aimed at the recipient."]
    },
    {
      "id": "CRED-HARVEST-LANG",
      "category": "credential",
      "weight": 12,
      "title": "Account-verification harvesting wording",
      "why": "Phrases like 'sign in to keep your access' or 'verify to avoid deletion' are engineered to push you toward a fake login page.",
      "advice": "Do not log in from a link. Open the provider's app or site yourself and check there.",
      "mitre": ["T1566.002"],
      "confidence": "medium",
      "patterns": [
        { "type": "anyOf", "values": ["sign in to review", "log in to review", "sign in to keep", "log in to keep", "sign in to maintain", "log in to maintain", "sign in to avoid", "log in to avoid", "sign in to prevent", "log in to prevent"] },
        { "type": "anyOf", "values": ["verify to avoid", "verify to prevent", "verify to continue", "verify your account to", "confirm your account to", "validate your account to", "revalidate your account", "reactivate your account", "restore your access", "restore account access"] },
        { "type": "anyOf", "values": ["keep your account active", "maintain your account", "avoid deactivation", "prevent deactivation", "keep access to your account", "retain access", "avoid service interruption", "continue using your account"] },
        { "type": "anyOf", "values": ["update your details to", "update your information to", "keep your information up to date", "confirm your details to", "review your account information", "update your kyc", "complete your kyc", "kyc will expire", "kyc is pending", "re-kyc", "rekyc"] },
        { "type": "proximity", "a": ["verify", "confirm", "validate", "reactivate", "restore", "update"], "b": ["account", "identity", "details", "information", "kyc", "access", "profile"], "distance": 4 }
      ],
      "negations": ["no action required", "no action needed", "you do not need to"],
      "examples": ["Sign in to review your account and avoid deactivation.", "Your KYC will expire today - complete your KYC to keep access."],
      "falsePositives": ["Onboarding and legitimate re-verification campaigns exist; weight alongside links and sender identity."]
    }
  ]
}
