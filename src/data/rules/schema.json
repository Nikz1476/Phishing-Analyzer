{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phrase rule pack",
  "description": "Schema every src/data/rules/*.json pack (except this schema file) must satisfy. Validated in CI by tests/unit/rule-schema.test.ts so a typo cannot silently disable a rule.",
  "type": "object",
  "required": ["version", "rules"],
  "properties": {
    "version": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "weight", "title", "why", "advice", "mitre", "confidence", "patterns"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
          "category": {
            "enum": ["language", "credential", "financial", "url", "attachment", "header", "impersonation", "technique", "evasion"]
          },
          "weight": { "type": "number", "minimum": 0 },
          "title": { "type": "string", "minLength": 3 },
          "why": { "type": "string", "minLength": 10 },
          "advice": { "type": "string", "minLength": 10 },
          "mitre": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "confidence": { "enum": ["low", "medium", "high"] },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "enum": ["phrase", "regex", "proximity", "anyOf"] },
                "value": { "type": "string" },
                "values": { "type": "array", "items": { "type": "string" } },
                "a": { "type": "array", "items": { "type": "string" } },
                "b": { "type": "array", "items": { "type": "string" } },
                "distance": { "type": "number" },
                "flags": { "type": "string" },
                "nearby": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "requiresAny": {
            "description": "Context gate. The rule only fires when at least one of these message-level flags is true. Used by rules that are only meaningful alongside a link, an attachment, a password form, etc.",
            "type": "array",
            "items": { "enum": ["has-url", "has-attachment", "has-password-form", "has-html-form", "has-qr", "has-crypto-address"] }
          },
          "negations": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } },
          "falsePositives": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
